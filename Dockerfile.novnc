FROM python:3.12-slim

WORKDIR /app
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt \
    && playwright install --with-deps chromium \
    && apt-get update \
    && apt-get install -y --no-install-recommends dumb-init fluxbox novnc websockify x11vnc xvfb \
    && rm -rf /var/lib/apt/lists/*
COPY doubao2api/ doubao2api/
COPY scripts/novnc-entrypoint.sh /usr/local/bin/novnc-entrypoint.sh
RUN chmod +x /usr/local/bin/novnc-entrypoint.sh && mkdir -p /app/data /tmp/doubao-novnc

ENV DOUBAO_HOST=0.0.0.0 DOUBAO_PORT=9090 \
    DOUBAO_ACCOUNT_DATA_DIR=/app/data DOUBAO_BROWSER_DATA=/app/data/browser \
    DOUBAO_SESSION_FILE=/app/data/.doubao_session.json DOUBAO_HEADLESS=true \
    DOUBAO_CLEAR_STALE_PROFILE_LOCKS=false
EXPOSE 9090 6080
ENTRYPOINT ["/usr/bin/dumb-init", "--", "/usr/local/bin/novnc-entrypoint.sh"]
CMD ["python", "-m", "doubao2api"]
